# Voxim server deployment (.env next to docker-compose.yml). Copy to .env and fill in.
# Container paths below are inside the data dir mounted at /srv/voxim (VOXIM_DATA_DIR on the host).

# --- Release -----------------------------------------------------------------
VOXIM_VERSION=20260930-release01
VOXIM_DATA_DIR=./data
# Memory ceiling for the app container (World + all Scene peer nodes). Size it below host RAM.
VOXIM_MEM_LIMIT=4000m
# Scheduler threads of the main node; peer Scenes take theirs from the topology file.
ERL_FLAGS=+S 2:2
RELEASE_NODE=voxim@127.0.0.1
RELEASE_COOKIE=change-me-to-a-long-random-string
SECRET_KEY_BASE=change-me-64-bytes-mix-phx-gen-secret
# 玩家门户主机：验证/重置邮件里的链接指向这里（见 README“域名”）。
PHX_HOST=account.hemifuture.cn

# --- Database (compose `db` service, published on 127.0.0.1 only) --------------
MMO_DB_USER=voxim
MMO_DB_PASSWORD=change-me
MMO_DB_NAME=voxim
MMO_DB_PORT=24632
MMO_DB_POOL_SIZE=10

# --- Network -------------------------------------------------------------------
AUTH_PORT=24640
# HTTP 监听地址：host 网络默认只听回环，由 nginx 转发；桥接网络部署改为 0.0.0.0。
AUTH_BIND_IP=127.0.0.1
VOXIM_QUIC_PORT=24643
VOXIM_QUIC_CERT=/srv/voxim/tls/server.pem
VOXIM_QUIC_KEY=/srv/voxim/tls/server.key

# --- Account mail (Aliyun DirectMail; implicit TLS with certificate checks) ------
VOXIM_MAIL_HOST=smtpdm.aliyun.com
VOXIM_MAIL_PORT=465
VOXIM_MAIL_FROM=noreply@notify.mmo.hemifuture.cn
VOXIM_MAIL_USER=noreply@notify.mmo.hemifuture.cn
VOXIM_MAIL_PASSWORD=change-me-from-the-directmail-console

# --- World ---------------------------------------------------------------------
# Generated baseline cache root + the explicit worldgen manifest (content_version is derived from it).
VOXEL_REGION_ROOT=/srv/voxim/world
VOXEL_REGION_MANIFEST=/srv/voxim/worldgen-manifest.json
VOXEL_REGION_PAYLOAD_CACHE_MB=256
VOXEL_REGION_GENERATION_CONCURRENCY=2
# Published kernel manifest (entry identity kernel_id = sha256 of this file).
VOXIM_KERNEL_MANIFEST=/srv/voxim/kernel-manifest.bin
# Primary Scene config (Gate entry bounds, profile_id). With VOXIM_TOPOLOGY the topology starts every Scene.
VOXIM_M1_CONFIG=/srv/voxim/scenes/scene-1.json
VOXIM_TOPOLOGY=/srv/voxim/scenes/topology.json

# --- Catalogs --------------------------------------------------------------------
VOXIM_PROPERTY_CATALOG_PATH=/srv/voxim/catalogs/properties.json
VOXIM_THERMAL_ENVIRONMENT_PATH=/srv/voxim/catalogs/environment.json
VOXIM_MAGIC_CATALOG_PATH=/srv/voxim/catalogs/magic-catalog.json
VOXIM_PREFAB_CATALOG_PATH=/srv/voxim/catalogs/prefabs
# Items increment 1: mixed ores 89 贫铜矿 and 90 富铜矿 sort into 铜精矿 16 and 砾石 6; all four must be listed to hold and sort.
VOXIM_PRODUCTION_MATERIALS=19,11,6,16,89,90
# Finite liquids are simulated inside this macro box only (x0,y0,z0,x1,y1,z1); unset disables liquids.
VOXIM_LIQUID_BOUNDS=-8192,-8192,-8192,8192,8192,8192
# Development convenience: every character counts as attuned to every teleport beacon (no visit needed). Unset = visit to attune.
# VOXIM_BEACONS_ALL_ATTUNED=1

# --- Access ----------------------------------------------------------------------
# Invite-code playtest login (POST /playtest/*). Leave DEV_AUTO_LOGIN=false on public servers.
VOXIM_PLAYTEST_ACCESS_FILE=/srv/voxim/invites.json
DEV_AUTO_LOGIN=false

# --- NPC (registry brains "npc", "llm", "life") ---------------------------------------
# 用途与请求形状见 apps/npc_server/lib/npc_server/README.md（“注册表”“反思”两节）与 deploy/README.md“NPC 常驻应用”。
# 整组注释掉、值留空：启用 NPC 登记时取消注释并填写。可选项不用就保持注释——空值不等于不写
# （API / THINKING / MAX_TOKENS / TIMEOUT_MS 为空时登记被拒，EFFORT 为空时空串会原样随请求发出，CACERTFILE 为空时空串会被当成 CA 文件路径）。
# 各 *_KEY 在 NPC 进程里以闭包流转、不进日志；建议同时关闭崩溃转储（见下面 ERL_CRASH_DUMP_BYTES）。
# 各 *_KEY 必须是合法的 HTTP 头值：非空、只含可见 ASCII（中间可有空格 / 制表符）、首尾无空白；CR / LF、NBSP、零宽空格、
# 全角字符都会让登记被拒，不会自动去掉（Windows 编辑留下的 CRLF、从网页复制带进的不可见字符要先改掉）。
#
# LLM 大脑（注册表 brain "llm" / "life"）：Responses 接口的完整地址、API key、模型名（三项必填）。
# NPC_LLM_URL=
# NPC_LLM_KEY=
# NPC_LLM_MODEL=
# 可选：思考强度（缺省 low）、https 只信的 CA 文件路径（不写用系统 CA）、单次请求超时毫秒（缺省 60000）。
# NPC_LLM_EFFORT=
# NPC_LLM_CACERTFILE=
# NPC_LLM_TIMEOUT_MS=
#
# 选择位置（Jev）的入口形状：不写 = TypeSafe（下面 TYPESAFE_* 三项必填）；openai = OpenAI 兼容 chat completions（NPC_JEV_URL/KEY/MODEL 必填）。
# NPC_JEV_API=
# TypeSafe System One：服务地址、API key、模型名。
# TYPESAFE_API_URL=
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=
# OpenAI 兼容入口：完整的 chat completions 地址、API key、模型名。
# NPC_JEV_URL=
# NPC_JEV_KEY=
# NPC_JEV_MODEL=
# 可选（仅 openai 入口）：思考强度（缺省 medium）、max_tokens（缺省 8192）、思考开关（enabled / disabled）。
# NPC_JEV_EFFORT=
# NPC_JEV_MAX_TOKENS=
# NPC_JEV_THINKING=
#
# 写作位置（反思、日计划、说话）：入口形状（不写 = Anthropic Messages；openai = chat completions）、完整的请求地址、API key、模型名。
# NPC_REFLECT_API=
# NPC_REFLECT_URL=
# NPC_REFLECT_KEY=
# NPC_REFLECT_MODEL=
# 可选（仅 openai 入口）：思考强度（缺省 medium）。
# NPC_REFLECT_EFFORT=
#
# 记忆库（Hindsight）服务地址（也可写在登记参数的 life.url 里）。配了它即“NPC 启用”：下面的花费额度一组必填。
# Hindsight 侧 HINDSIGHT_API_LLM_TRACE_ENABLED（用量读回的来源）与 ENABLE_BANK_CONFIG_API（自动巩固开关）不得关。
# NPC_LIFE_HINDSIGHT_URL=
#
# 每天模型花费额度（NpcServer.SpendBudget，北京自然日；决策稿 docs/10-active/cross-cutting/2026-11-18-npc-spend-budget-decision.md）。
# 配了 NPC_LIFE_HINDSIGHT_URL 时前三项必填，缺或非法 release 启动失败（错误只点变量名）。到停止线（上限 × 比例）只停后台
# （认识刷新、反思、日计划、Hindsight 自动巩固），选择、说话、召回、写入经历照常；北京零点恢复。
# 上限（美元）与后台停止线占上限的比例（用户 2026-11-18 定：65 与 0.9）。
# NPC_SPEND_LIMIT_USD=65
# NPC_SPEND_STOP_RATIO=0.9
# 价目（美元 / 百万 token，JSON 一行）：模型名 → peak / off_peak 各三项 miss（入未命中）/ hit（入命中）/ out（出，思考按出计）。
# 产品的选择与写作模型（NPC_JEV_MODEL 或 TYPESAFE_MODEL、NPC_REFLECT_MODEL）必须在里面；Hindsight 用的模型不在表里时后台按“未定价”停。
# DeepSeek 官方价目页 2026-11-19 核对的 deepseek-flash：
# NPC_SPEND_PRICES={"deepseek-flash":{"peak":{"miss":0.3,"hit":0.006,"out":1.2},"off_peak":{"miss":0.15,"hit":0.003,"out":0.6}}}
# 可选：按 UTC 的高峰规则，不写 = 每一刻都按高峰价计（偏贵，安全侧）。形状：一条或多条规则，分号分隔；每条“星期 时段[,时段…]”，
# 星期写 mon … sun 或 mon-fri 这样的一段（不跨周日到周一），时段是 UTC 的 HH:MM-HH:MM（左闭右开，可写到 24:00）；其余时刻为非高峰。
# DeepSeek 官方：高峰是周一至周五 UTC 01:00-04:00 与 06:00-10:00（北京 09:00-12:00、14:00-18:00），周末全天非高峰。
# 中国法定节假日（官方也算非高峰）不建模：节假日的工作日白天按高峰计（多计，不少计）。
# NPC_SPEND_PEAK_UTC=mon-fri 01:00-04:00,06:00-10:00
#
# 崩溃转储：0 = VM 崩溃时不写 erl_crash.dump（转储会带上发请求那一刻的明文请求头）。取舍见 deploy/README.md。
# ERL_CRASH_DUMP_BYTES=0
