# Voxim server deployment (.env next to docker-compose.yml). Copy to .env and fill in.
# Container paths below are inside the data dir mounted at /srv/voxim (VOXIM_DATA_DIR on the host).

# --- Release -----------------------------------------------------------------
VOXIM_VERSION=20260930-release01
VOXIM_DATA_DIR=./data
# Memory ceiling for the app container (World + all Scene peer nodes). Size it below host RAM.
VOXIM_MEM_LIMIT=4000m
# Scheduler threads of the main node; peer Scenes take theirs from the topology file.
ERL_FLAGS=+S 2:2
RELEASE_NODE=voxim@127.0.0.1
RELEASE_COOKIE=change-me-to-a-long-random-string
SECRET_KEY_BASE=change-me-64-bytes-mix-phx-gen-secret
# 玩家门户主机：验证/重置邮件里的链接指向这里（见 README“域名”）。
PHX_HOST=voxim.hemifuture.cn

# --- Database (compose `db` service, published on 127.0.0.1 only) --------------
MMO_DB_USER=voxim
MMO_DB_PASSWORD=change-me
MMO_DB_NAME=voxim
MMO_DB_PORT=24632
MMO_DB_POOL_SIZE=10

# --- Network -------------------------------------------------------------------
AUTH_PORT=24640
# HTTP 监听地址：host 网络默认只听回环，由 nginx 转发；桥接网络部署改为 0.0.0.0。
AUTH_BIND_IP=127.0.0.1
VOXIM_QUIC_PORT=24643
VOXIM_QUIC_CERT=/srv/voxim/tls/server.pem
VOXIM_QUIC_KEY=/srv/voxim/tls/server.key

# --- World ---------------------------------------------------------------------
# Generated baseline cache root + the explicit worldgen manifest (content_version is derived from it).
VOXEL_REGION_ROOT=/srv/voxim/world
VOXEL_REGION_MANIFEST=/srv/voxim/worldgen-manifest.json
VOXEL_REGION_PAYLOAD_CACHE_MB=256
VOXEL_REGION_GENERATION_CONCURRENCY=2
# Published kernel manifest (entry identity kernel_id = sha256 of this file).
VOXIM_KERNEL_MANIFEST=/srv/voxim/kernel-manifest.bin
# Primary Scene config (Gate entry bounds, profile_id). With VOXIM_TOPOLOGY the topology starts every Scene.
VOXIM_M1_CONFIG=/srv/voxim/scenes/scene-1.json
VOXIM_TOPOLOGY=/srv/voxim/scenes/topology.json

# --- Catalogs --------------------------------------------------------------------
VOXIM_PROPERTY_CATALOG_PATH=/srv/voxim/catalogs/properties.json
VOXIM_THERMAL_ENVIRONMENT_PATH=/srv/voxim/catalogs/environment.json
VOXIM_MAGIC_CATALOG_PATH=/srv/voxim/catalogs/magic-catalog.json
VOXIM_PREFAB_CATALOG_PATH=/srv/voxim/catalogs/prefabs
VOXIM_PRODUCTION_MATERIALS=19,11
# Finite liquids are simulated inside this macro box only (x0,y0,z0,x1,y1,z1); unset disables liquids.
VOXIM_LIQUID_BOUNDS=-8192,-8192,-8192,8192,8192,8192

# --- Access ----------------------------------------------------------------------
# Invite-code playtest login (POST /playtest/*). Leave DEV_AUTO_LOGIN=false on public servers.
VOXIM_PLAYTEST_ACCESS_FILE=/srv/voxim/invites.json
DEV_AUTO_LOGIN=false
