# Host nginx: TLS termination for the Voxim HTTP API (login / regions / prefabs).
# QUIC (UDP ${VOXIM_QUIC_PORT}) is not proxied; the client connects to it directly.
server {
    listen 443 ssl;
    server_name mmo.example.com;

    ssl_certificate     /etc/nginx/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/example/privkey.pem;

    # Invite-code playtest routes. Cold region requests can take tens of seconds on a fresh cache.
    location /playtest/ {
        proxy_pass http://127.0.0.1:24640;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        client_max_body_size 16m;
    }
}
