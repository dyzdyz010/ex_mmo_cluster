<UI.page title={title(@screen)} nav={nav(@viewer)} current={current(@screen)} viewer={@viewer}>
  <div :if={@screen != :manage} class="sk-container ac-w-auth ac-auth">
    <section class="ac-intro" aria-label="Voxim 账号介绍">
      <p class="ac-eyebrow"><span class="ac-dot"></span>Voxim Account · Qinglan</p>
      <p class="ac-display">一个账号，<br /><span class="ac-gradient">通往青岚。</span></p>
      <p class="ac-lead">注册、找回密码与登录设备管理都在这里完成。进入游戏时，在 Voxim 客户端使用同一邮箱和密码登录。</p>
      <ol class="ac-flow">
        <li><span>01</span><strong>创建账号</strong><p>验证邮箱并设置密码</p></li>
        <li><span>02</span><strong>进入青岚</strong><p>在游戏登录面板使用同一账号</p></li>
        <li><span>03</span><strong>管理安全</strong><p>修改密码或退出全部设备</p></li>
      </ol>
    </section>

    <section :if={@screen == :login} class="ac-card" aria-labelledby="screen-title">
      <p class="ac-eyebrow"><span class="ac-dot ac-dot--cyan"></span>Sign in</p>
      <h1 id="screen-title" class="ac-title">登录账号中心</h1>
      <p class="ac-text">在这里管理密码和登录设备。进入青岚，请打开 Voxim 游戏并登录。</p>
      <UI.notice notice={@notice} />
      <.form for={%{}} action="/auth/login" class="ac-form">
        <div class="ac-field">
          <label class="ac-label" for="email">邮箱</label>
          <input id="email" name="email" type="email" class="ac-input" value={@email} autocomplete="username" maxlength="254" placeholder="you@example.com" autofocus={@email == ""} required />
        </div>
        <UI.secret id="password" name="password" label="密码" autocomplete="current-password" autofocus={@email != ""}>
          <:aside><a href="/auth/forgot">忘记密码？</a></:aside>
        </UI.secret>
        <button class="ac-btn ac-btn--primary ac-btn--block">登录<span class="ac-arrow" aria-hidden="true">→</span></button>
      </.form>
      <div class="ac-card-foot">
        <span>还没有账号？<a href="/auth/register">注册</a></span>
        <a href="/auth/claim">绑定原角色</a>
      </div>
    </section>

    <section :if={@screen == :register} class="ac-card ac-card--violet" aria-labelledby="screen-title">
      <p class="ac-eyebrow"><span class="ac-dot ac-dot--violet"></span>Create account</p>
      <h1 id="screen-title" class="ac-title">创建 Voxim 账号</h1>
      <p class="ac-text">
        <UI.badge tone={if @invite_required, do: "gold", else: "positive"}>{if @invite_required, do: "邀请注册", else: "开放注册"}</UI.badge>
        {if @invite_required, do: "请填写管理员发放的邀请码。", else: "当前无需邀请码。"}
      </p>
      <ol class="ac-steps" aria-label="注册步骤">
        <li class={@sent && "is-done"} aria-current={!@sent && "step"}><b>{if @sent, do: "✓", else: "01"}</b>验证邮箱</li>
        <li aria-current={@sent && "step"}><b>02</b>设置密码</li>
      </ol>
      <UI.notice notice={@notice} />
      <.form for={%{}} action="/auth/register" class="ac-form">
        <fieldset class="ac-group">
          <legend class="ac-legend">01 · 验证邮箱</legend>
          <div class="ac-field">
            <label class="ac-label" for="email">邮箱</label>
            <input id="email" name="email" type="email" class="ac-input" value={@email} autocomplete="email" maxlength="254" placeholder="you@example.com" autofocus={!@sent} required />
          </div>
          <div :if={@invite_required} class="ac-field">
            <label class="ac-label" for="invite">邀请码</label>
            <input id="invite" name="invite" class="ac-input ac-input--invite" value={@invite} placeholder="5 位字母＋数字，不区分大小写" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="128" required />
          </div>
          <button formaction="/auth/registration-email" formnovalidate class="ac-btn ac-btn--block" data-cooldown={@sent && "60"}>
            {if @sent, do: "重新发送验证码", else: "发送注册验证码"}
          </button>
        </fieldset>
        <fieldset class="ac-group" data-enter-submits="step-submit">
          <legend class="ac-legend">02 · 设置密码</legend>
          <div class="ac-field">
            <label class="ac-label" for="code">邮箱验证码</label>
            <input id="code" name="code" class="ac-input ac-input--code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6 位数字" autofocus={@sent} required />
            <p class="ac-hint">验证码 10 分钟内有效。邀请码与邮箱验证码是两个不同的凭据。</p>
          </div>
          <UI.secret id="password" name="password" label="设置密码" autocomplete="new-password" minlength={15} counter />
          <button id="step-submit" class="ac-btn ac-btn--primary ac-btn--block">创建账号<span class="ac-arrow" aria-hidden="true">→</span></button>
        </fieldset>
      </.form>
      <div class="ac-card-foot">
        <span>已有账号？<a href="/auth/login">登录</a></span>
        <a href="/auth/claim">已有旧登录邀请码？绑定原角色</a>
      </div>
    </section>

    <section :if={@screen == :forgot} class="ac-card ac-card--gold" aria-labelledby="screen-title">
      <p class="ac-eyebrow"><span class="ac-dot ac-dot--gold"></span>Recovery</p>
      <h1 id="screen-title" class="ac-title">找回密码</h1>
      <p class="ac-text">输入注册邮箱，我们会发送一封密码重置邮件。邮件中的按钮可直接打开重置页面。</p>
      <UI.notice notice={@notice} />
      <.form for={%{}} action="/auth/forgot" class="ac-form">
        <div class="ac-field">
          <label class="ac-label" for="email">邮箱</label>
          <input id="email" name="email" type="email" class="ac-input" value={@email} autocomplete="email" maxlength="254" placeholder="you@example.com" autofocus required />
        </div>
        <button class={["ac-btn ac-btn--block", !@sent && "ac-btn--primary"]} data-cooldown={@sent && "60"}>
          {if @sent, do: "重新发送重置邮件", else: "发送重置邮件"}
        </button>
      </.form>
      <a href="/auth/reset" class={["ac-btn ac-btn--block ac-gap-top", @sent && "ac-btn--primary"]}>已有重置码，设置新密码</a>
      <div class="ac-card-foot">
        <a href="/auth/login">返回登录</a>
      </div>
    </section>

    <section :if={@screen == :reset} class="ac-card ac-card--gold" aria-labelledby="screen-title">
      <p class="ac-eyebrow"><span class="ac-dot ac-dot--gold"></span>Recovery</p>
      <h1 id="screen-title" class="ac-title">重置密码</h1>
      <p class="ac-text">成功后所有设备与游戏连接都会退出。从邮件按钮打开时，邮箱和重置码会自动填好。</p>
      <UI.notice notice={@notice} />
      <.form for={%{}} action="/auth/reset" class="ac-form" data-prefill>
        <div class="ac-field">
          <label class="ac-label" for="email">邮箱</label>
          <input id="email" name="email" type="email" class="ac-input" value={@email} autocomplete="email" maxlength="254" placeholder="you@example.com" required />
        </div>
        <div class="ac-field">
          <label class="ac-label" for="code">邮件重置码</label>
          <input id="code" name="code" class="ac-input ac-input--token" autocomplete="one-time-code" maxlength="128" spellcheck="false" required />
          <p class="ac-hint">重置码 30 分钟内有效。</p>
        </div>
        <UI.secret id="password" name="password" label="新密码" autocomplete="new-password" minlength={15} counter />
        <button class="ac-btn ac-btn--primary ac-btn--block">重置密码</button>
      </.form>
      <div class="ac-card-foot">
        <a href="/auth/forgot">重新发送重置邮件</a>
        <a href="/auth/login">返回登录</a>
      </div>
    </section>

    <section :if={@screen == :claim} class="ac-card ac-card--violet" aria-labelledby="screen-title">
      <p class="ac-eyebrow"><span class="ac-dot ac-dot--violet"></span>Legacy character</p>
      <h1 id="screen-title" class="ac-title">绑定原角色</h1>
      <p class="ac-text">使用内测时的原登录邀请码验证身份，为原角色绑定邮箱和密码。角色与存档保持不变。</p>
      <ol class="ac-steps" aria-label="绑定步骤">
        <li class={@sent && "is-done"} aria-current={!@sent && "step"}><b>{if @sent, do: "✓", else: "01"}</b>验证身份</li>
        <li aria-current={@sent && "step"}><b>02</b>设置密码</li>
      </ol>
      <UI.notice notice={@notice} />
      <.form for={%{}} action="/auth/claim" class="ac-form" data-prefill>
        <fieldset class="ac-group">
          <legend class="ac-legend">01 · 验证身份</legend>
          <div class="ac-field">
            <label class="ac-label" for="email">邮箱</label>
            <input id="email" name="email" type="email" class="ac-input" value={@email} autocomplete="email" maxlength="254" placeholder="you@example.com" autofocus={!@sent} required />
          </div>
          <div class="ac-field">
            <label class="ac-label" for="legacy">原登录邀请码</label>
            <input id="legacy" name="legacy_code" type="password" class="ac-input" autocomplete="off" maxlength="256" autofocus={@sent} required />
            <p class={["ac-hint", @sent && "ac-hint--warn"]}>
              {if @sent, do: "为保护原角色，页面不会保留原登录邀请码，请重新输入。", else: "原登录邀请码只用于本次认领，不会显示在页面上。"}
            </p>
          </div>
          <button formaction="/auth/claim-email" formnovalidate class="ac-btn ac-btn--block" data-cooldown={@sent && "60"}>
            {if @sent, do: "重新发送认领验证码", else: "发送认领验证码"}
          </button>
        </fieldset>
        <fieldset class="ac-group" data-enter-submits="step-submit">
          <legend class="ac-legend">02 · 设置密码</legend>
          <div class="ac-field">
            <label class="ac-label" for="code">邮箱验证码</label>
            <input id="code" name="code" autocomplete="one-time-code" maxlength="128" class="ac-input ac-input--token" spellcheck="false" required />
            <p class="ac-hint">验证码 10 分钟内有效；从邮件按钮打开时会自动填好。</p>
          </div>
          <UI.secret id="password" name="password" label="设置密码" autocomplete="new-password" minlength={15} counter />
          <button id="step-submit" class="ac-btn ac-btn--primary ac-btn--block">绑定原角色</button>
        </fieldset>
      </.form>
      <div class="ac-card-foot">
        <a href="/auth/register">注册新账号</a>
        <a href="/auth/login">返回登录</a>
      </div>
    </section>
  </div>

  <div :if={@screen == :manage} class="sk-container ac-w-page">
    <div class="ac-page-head">
      <div>
        <p class="ac-eyebrow"><span class="ac-dot"></span>Account · Overview</p>
        <h1 class="ac-h1">账号管理</h1>
      </div>
    </div>
    <UI.notice notice={@notice} />
    <dl class="ac-stats">
      <div class="ac-stat"><dt>邮箱</dt><dd>{@viewer.email}</dd></div>
      <div class="ac-stat"><dt>角色</dt><dd>{@viewer.character}</dd></div>
      <div class="ac-stat"><dt>账号 ID</dt><dd class="ac-mono">{Integer.to_string(@account.account_id)}</dd></div>
    </dl>
    <div class="ac-grid">
      <section class="ac-card" aria-labelledby="password-title">
        <p class="ac-eyebrow">Security</p>
        <h2 id="password-title" class="ac-h2">修改密码</h2>
        <p class="ac-text">修改后所有设备与游戏连接都会退出，请使用新密码重新登录。</p>
        <.form for={%{}} action="/auth/change-password" class="ac-form">
          <UI.secret id="current" name="current_password" label="当前密码" autocomplete="current-password" />
          <UI.secret id="password" name="password" label="新密码" autocomplete="new-password" minlength={15} counter />
          <button class="ac-btn ac-btn--primary">修改密码</button>
        </.form>
      </section>
      <div class="ac-stack">
        <section class="ac-card ac-card--violet" aria-labelledby="play-title">
          <p class="ac-eyebrow"><span class="ac-dot ac-dot--violet"></span>Play</p>
          <h2 id="play-title" class="ac-h2">进入青岚</h2>
          <ul class="ac-keys">
            <li><span>01</span>打开 Voxim 客户端，在登录面板输入此邮箱和密码。</li>
            <li><span>02</span>勾选“在此设备保持登录”，下次启动自动进入。</li>
            <li><span>03</span>同一账号同时只保留一个游戏连接。</li>
          </ul>
        </section>
        <section class="ac-card ac-card--magenta" aria-labelledby="session-title">
          <p class="ac-eyebrow">Sessions</p>
          <h2 id="session-title" class="ac-h2">登录会话</h2>
          <p class="ac-text">退出网页只结束本次网页登录；怀疑密码泄露时，请退出全部设备并修改密码。</p>
          <div class="ac-actions ac-gap-top">
            <.form for={%{}} action="/auth/logout"><button class="ac-btn">退出账号网页</button></.form>
          </div>
          <details class="ac-confirm">
            <summary>退出全部设备…</summary>
            <div class="ac-confirm__body">
              <p>所有网页登录与游戏连接会立即关闭，正在游戏中的角色将被断开。</p>
              <.form for={%{}} action="/auth/logout-all"><button class="ac-btn ac-btn--danger ac-btn--block">确认退出全部设备</button></.form>
            </div>
          </details>
        </section>
      </div>
    </div>
  </div>
</UI.page>
